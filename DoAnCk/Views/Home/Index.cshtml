@model IEnumerable<DoAnCk.Models.Entities.Room>
@{
    ViewData["Title"] = "Trang chủ - EasyRent";
}

<div class="hero-wrapper">
    <div class="hero-content text-center text-white">
        <h1 class="fw-bold display-4 mb-3">Tìm phòng trọ nhanh, thuê dễ dàng</h1>
        <p class="lead mb-4">Hệ thống xác thực thông tin giúp bạn an tâm tuyệt đối</p>
        <div class="container">
            <div class="search-main shadow-lg bg-white p-2 rounded-pill mx-auto" style="max-width: 900px;">
                <form class="row g-0 align-items-center px-3">
                    <div class="col-md-5 border-end">
                        <input type="text" class="form-control border-0 no-shadow" placeholder="Quận, tên đường...">
                    </div>
                    <div class="col-md-4 border-end">
                        <select class="form-select border-0 no-shadow">
                            <option>Tất cả loại phòng</option>
                        </select>
                    </div>
                    <div class="col-md-3 ps-2">
                        <button type="button" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">TÌM KIẾM</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container my-5 pt-4">
    <div class="d-flex align-items-center mb-4">
        <div class="flex-shrink-0 bg-warning rounded-circle me-3" style="width: 12px; height: 12px;"></div>
        <h2 class="fw-bold mb-0">Lựa chọn tốt nhất cho bạn</h2>
    </div>

    <div class="row g-4">
        @if (Model != null)
        {
            @foreach (var item in Model.Take(3))
            {
                <div class="col-lg-4 col-md-6">
                    <div class="room-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative">
                            <img src="@(item.RoomImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png")"
                                 class="card-img-top" style="height: 220px; object-fit: cover;">
                            <div class="price-overlay">@item.Price.ToString("N0") đ</div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-dark text-truncate">@item.Title</h5>
                            <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt me-2"></i>@item.Address</p>
                            <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100">
                                XEM CHI TIẾT
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary text-uppercase">Phòng trọ cho thuê tại TP. HCM</h2>
            <div class="title-divider mx-auto mb-4" style="width: 80px; height: 3px; background: #007bff;"></div>
            <p class="text-muted">Nhấn vào Quận/Huyện để xem danh sách phòng tương ứng</p>
        </div>

        <div class="row g-3 justify-content-center district-image-grid mb-5">
            @{
                // Tạo một danh sách các quận với hình ảnh minh họa (link ảnh lấy từ Unsplash)B
                // Trong thực tế, bạn nên lấy dữ liệu này từ Database table 'Districts'
                var districtsData = new[] {
                        new { Name = "Quận 1", Image = "/images/Quan1.jpg" },
                        new { Name = "Quận 3", Image = "/images/Quan3.jpg" },
                        new { Name = "Quận 4", Image = "/images/Quan4.jpg" },
                        new { Name = "Quận 5", Image = "/images/Quan5.jpg" },
                        new { Name = "Quận 6", Image = "/images/Quan6.jpg" },
                        new { Name = "Quận 7", Image = "/images/Quan7.jpg" },
                        new { Name = "Quận 8", Image = "/images/Quan8.jpg" },
                        new { Name = "Quận 10", Image = "/images/Quan10.jpg" },
                        new { Name = "Quận 11", Image = "/images/Quan11.jpg" },
                        new { Name = "Quận 12", Image = "/images/Quan12.jpg" },
                        new { Name = "Bình Tân", Image = "/images/BinhTan.jpg" },
                        new { Name = "Bình Thạnh", Image = "/images/BinhThanh.jpg" },
                        new { Name = "Gò Vấp", Image = "/images/GoVap.jpg" },
                        new { Name = "Phú Nhuận", Image = "/images/Phunhuan.jpg" },
                        new { Name = "Tân Bình", Image = "/images/TanBinh.jpg" },
                        new { Name = "Tân Phú", Image = "/images/TanPhu.jpg" },
                        new { Name = "Thủ Đức", Image = "/images/ThuDuc.jpg" },
                        new { Name = "Hóc Môn", Image = "/images/HocMon.jpg" }, 
                        new { Name = "Nhà Bè", Image = "/images/NhaBe.jpg" }    
                        };
                var currentDistrict = Context.Request.Query["district"].ToString();
            }

            @foreach (var d in districtsData)
            {
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <a asp-action="Index" asp-route-district="@d.Name"
                       class="district-item card border-0 shadow-sm rounded-4 overflow-hidden h-100 @(currentDistrict == d.Name ? "active-district" : "")">
                        <img src="@d.Image" class="card-img-top" alt="@d.Name" style="height: 120px; object-fit: cover;">
                        <div class="card-body p-2 text-center bg-white">
                            <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;">@d.Name</h6>
                            @* (Tùy chọn) Hiện số lượng bài đăng: <small class="text-muted">(99+)</small> *@
                        </div>
                    </a>
                </div>
            }

            @if (!string.IsNullOrEmpty(currentDistrict))
            {
                <div class="col-12 text-center mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm fw-bold">
                        <i class="fas fa-times me-1"></i> Xóa lọc theo @currentDistrict
                    </a>
                </div>
            }
        </div>

        <div class="row g-4 mt-2">
            @if (Model != null && Model.Any())
            {
                // Logic lọc dữ liệu tại View (Khuyên dùng lọc tại Controller)
                var resultsRooms = Model.Skip(3); // Giữ nguyên logic skip 3 của bạn

                if (!string.IsNullOrEmpty(currentDistrict))
                {
                    resultsRooms = resultsRooms.Where(r => r.Address.Contains(currentDistrict));
                }

                if (resultsRooms.Any())
                {
                    <div class="col-12 mb-3">
                        <h5 class="fw-bold text-dark">
                            @(string.IsNullOrEmpty(currentDistrict) ? "Tất cả phòng TP.HCM" : $"Kết quả tìm kiếm tại {currentDistrict}")
                        </h5>
                    </div>

                    @foreach (var item in resultsRooms)
                    {
                        <div class="col-lg-3 col-md-6">
                            <div class="room-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                <div class="position-relative">
                                    <img src="@(item.RoomImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png")"
                                         class="card-img-top" style="height: 180px; object-fit: cover;">
                                    <div class="price-overlay">@item.Price.ToString("N0") đ</div>
                                </div>
                                <div class="card-body p-3 text-center">
                                    <h6 class="fw-bold text-dark text-truncate mb-2">@item.Title</h6>
                                    <p class="text-muted small mb-3">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i>
                                        @* Hiển thị quận lấy từ chuỗi địa chỉ *@
                                        @(item.Address.Contains(",") ? item.Address.Split(',').Last().Trim() : item.Address)
                                    </p>
                                    <a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id" class="btn btn-sm btn-view-detail w-100 rounded-pill">CHI TIẾT</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-search-location fa-4x text-muted opacity-50 mb-4"></i>
                        <p class="text-muted fst-italic">Hiện chưa có bài đăng nào được duyệt tại khu vực <strong>@currentDistrict</strong>.</p>
                        <a asp-action="Index" class="btn btn-link">Xem tất cả phòng</a>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="container py-5 text-center">
    <h2 class="fw-bold mb-5">Cẩm nang thuê phòng</h2>
    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="blog-item shadow-sm rounded-4 overflow-hidden bg-white text-start">
                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=500" class="w-100" style="height:200px; object-fit:cover;">
                <div class="p-3">
                    <h6 class="fw-bold text-dark">Lưu ý khi ký hợp đồng đặt cọc</h6>
                    <p class="text-muted small mb-0">Hỗ trợ bởi đội ngũ Admin EasyRent</p>
                </div>
            </div>
        </div>
    </div>
</div>