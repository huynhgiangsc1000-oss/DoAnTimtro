@using DoAnCk.Models.Entities
@model IEnumerable<DoAnCk.Models.Entities.Room>

<div class="container mt-4">
    <h2 class="mb-4 text-primary fw-bold">Phòng trọ mới nhất</h2>
    <div class="row g-4">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                        <div style="height: 180px; background: #eee;">
                            @{
                                var imgUrl = item.RoomImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                ?? item.RoomImages?.FirstOrDefault()?.ImageUrl
                                ?? "/images/no-image.jpg";
                            }
                            <img src="@imgUrl" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="@item.Title">
                        </div>
                        <div class="card-body">
                            @* LỖI TẠI ĐÂY ĐÃ ĐƯỢC SỬA: Thay .Name bằng .Title *@
                            <h6 class="card-title fw-bold text-truncate" title="@item.Title">@item.Title</h6>

                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @(item.Address ?? "Chưa có địa chỉ")
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">@item.Price.ToString("N0") đ</span>
                                <span class="badge bg-light text-dark border">@item.Area m²</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>