<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAnCk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnCk.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DoAnCk</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @* MENU CHO ADMIN *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Quản trị viên
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Quản lý danh mục</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Amenity" asp-action="Index">Quản lý tiện ích</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="RoomManagement" asp-action="Index">Duyệt tin đăng</a></li>
                                    </ul>
                                </li>
                            }
                            @* MENU CHO CHỦ TRỌ (HOST) - ĐÃ HOÀN CHỈNH *@
                            @if (User.IsInRole("Host"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-info btn-sm text-white rounded-pill px-3 shadow-sm fw-bold transition-all"
                                       asp-area="Host" asp-controller="Rooms" asp-action="Create">
                                        <i class="fas fa-plus-circle me-1"></i> Đăng tin
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium px-3" asp-area="Host" asp-controller="Rooms" asp-action="Index">
                                        <i class="fas fa-home me-1 text-primary"></i>
                                        <span class="d-none d-xl-inline">Phòng của tôi</span>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium px-3 position-relative" asp-area="Host" asp-controller="RoomRequests" asp-action="Index">
                                        <i class="fas fa-envelope-open-text me-1 text-warning"></i>
                                        <span class="d-none d-xl-inline">Yêu cầu</span>

                                        @* Giả sử bạn truyền số lượng qua ViewBag.PendingRequests *@
                                        @if (ViewBag.PendingRequests > 0)
                                        {
                                            <span class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                                @ViewBag.PendingRequests
                                            </span>
                                        }
                                    </a>
                                </li>
                            }
                            

                            @* MENU CHO NGƯỜI THUÊ (MEMBER/CUSTOMER) *@
                            @if (User.IsInRole("Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="Favorite" asp-action="Index">Tin đã lưu</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="MyRequest" asp-action="Index">Yêu cầu của tôi</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DoAnCk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>