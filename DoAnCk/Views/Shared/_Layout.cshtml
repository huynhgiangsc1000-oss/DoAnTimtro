<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAnCk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnCk.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">DoAnCk</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* MENU CHO ADMIN *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold"
                                       href="#"
                                       id="adminDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <i class="fa-solid fa-user-shield me-1"></i> Quản trị viên
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">
                                                Quản lý danh mục
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Amenity" asp-action="Index">
                                                Quản lý tiện ích
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="RoomManagement" asp-action="Index">
                                                Duyệt tin đăng
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @* MENU CHO CHỦ TRỌ *@
                            @if (User.IsInRole("Host"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary"
                                       href="#"
                                       id="hostDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <i class="fa-solid fa-house me-1"></i> Khu vực Chủ trọ
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="hostDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="Host" asp-controller="Room" asp-action="Create">
                                                Đăng tin mới
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Host" asp-controller="Room" asp-action="Index">
                                                Danh sách phòng của tôi
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Host" asp-controller="RoomRequest" asp-action="Index">
                                                Yêu cầu thuê/ở ghép
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @* MENU CHO NGƯỜI THUÊ *@
                            @if (User.IsInRole("Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="Favorites" asp-action="Index">
                                        <i class="fa-regular fa-heart me-1"></i> Tin đã lưu
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="RoomRequests" asp-action="Index">
                                        <i class="fa-regular fa-paper-plane me-1"></i> Yêu cầu của tôi
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="Reviews" asp-action="Index">
                                        <i class="fa-regular fa-star me-1"></i> Đánh giá của tôi
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DoAnCk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>