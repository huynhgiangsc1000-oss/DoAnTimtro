@using Microsoft.AspNetCore.Identity
@using DoAnCk.Models.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .nav-link {
            font-weight: 500;
            transition: 0.3s;
            border-radius: 8px;
        }

            .nav-link:hover {
                background-color: #f8f9fa;
                color: #0d6efd !important;
            }

        .admin-nav .nav-link {
            font-size: 0.9rem;
            padding: 0.5rem 0.8rem;
        }

        .navbar-brand {
            font-size: 1.5rem;
        }

        .active-link {
            color: #0d6efd !important;
            background-color: #e7f1ff;
        }
        /* Tách biệt các nhóm bằng đường kẻ dọc nhẹ */
        .nav-divider {
            border-left: 1px solid #dee2e6;
            margin: 0 10px;
            height: 24px;
            align-self: center;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-heart-fill"></i> EasyRent
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 admin-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-search"></i> Tìm phòng
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @* --- PHÂN HỆ ADMIN --- *@
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="nav-divider"></div>
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                                        <i class="bi bi-check2-square"></i> Duyệt tin
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people"></i> Người dùng
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                        <i class="bi bi-tags"></i> Danh mục
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Amenities" asp-action="Index">
                                        <i class="bi bi-gear"></i> Tiện ích
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                                        <i class="bi bi-chat-left-dots"></i> Bình luận
                                    </a>
                                </li>
                            }
                            @* MENU CHO CHỦ TRỌ (HOST) - ĐÃ HOÀN CHỈNH *@
                            @if (User.IsInRole("Host"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-info btn-sm text-white rounded-pill px-3 shadow-sm fw-bold transition-all"
                                       asp-area="Host" asp-controller="Rooms" asp-action="Create">
                                        <i class="fas fa-plus-circle me-1"></i> Đăng tin
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium px-3" asp-area="Host" asp-controller="Rooms" asp-action="Index">
                                        <i class="fas fa-home me-1 text-primary"></i>
                                        <span class="d-none d-xl-inline">Phòng của tôi</span>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium px-3 position-relative" asp-area="Host" asp-controller="RoomRequests" asp-action="Index">
                                        <i class="fas fa-envelope-open-text me-1 text-warning"></i>
                                        <span class="d-none d-xl-inline">Yêu cầu</span>

                                        @* Giả sử bạn truyền số lượng qua ViewBag.PendingRequests *@
                                        @if (ViewBag.PendingRequests > 0)
                                        {
                                            <span class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                                @ViewBag.PendingRequests
                                            </span>
                                        }
                                    </a>
                                </li>
                            }
                            

                            @* --- PHÂN HỆ NGƯỜI THUÊ (CUSTOMER / MEMBER) --- *@
                            @if (User.IsInRole("Member") || User.IsInRole("Customer"))
                            {
                                <div class="nav-divider"></div>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-area="Customer" asp-controller="Favorite" asp-action="Index">
                                        <i class="bi bi-heart-fill"></i> Đã lưu
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Customer" asp-controller="MyRequest" asp-action="Index">
                                        <i class="bi bi-send"></i> Yêu cầu đã gửi
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light py-4 mt-auto">
        <div class="container text-center">
            <div class="mb-2">
                <span class="fw-bold text-primary">EasyRent</span> - Hệ thống quản lý và tìm kiếm phòng trọ số 1.
            </div>
            &copy; 2026 - <strong>EasyRentProject</strong> - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Chính sách bảo mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>