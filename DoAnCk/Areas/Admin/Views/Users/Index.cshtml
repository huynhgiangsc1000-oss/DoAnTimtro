@using DoAnCk.Areas.Admin.Controllers
@model IEnumerable<UserListViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary m-0"><i class="bi bi-people"></i> Quản lý người dùng</h2>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ tên / ID</th>
                        <th>Liên hệ</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.User.FullName</div>
                                <small class="text-muted" style="font-size: 0.75rem;">ID: @item.User.Id</small>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope-at size-sm"></i> @item.User.Email</div>
                                <small class="text-muted"><i class="bi bi-telephone"></i> @(item.User.PhoneNumber ?? "Chưa cập nhật")</small>
                            </td>
                            <td>
                                @if (item.Roles.Contains("Admin"))
                                {
                                    <span class="badge bg-primary text-white"><i class="bi bi-shield-lock"></i> Admin</span>
                                }
                                else if (item.Roles.Contains("Host"))
                                {
                                    <span class="badge bg-success text-white"><i class="bi bi-house-door"></i> Host</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-person"></i> Member</span>
                                }
                            </td>
                            <td>
                                @if (item.User.LockoutEnd > DateTime.Now)
                                {
                                    <span class="badge bg-danger">Đang bị khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="ToggleLock" asp-route-id="@item.User.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.User.LockoutEnd > DateTime.Now ? "btn-warning" : "btn-outline-danger") rounded-pill px-3">
                                        <i class="bi @(item.User.LockoutEnd > DateTime.Now ? "bi-unlock" : "bi-lock")"></i>
                                        @(item.User.LockoutEnd > DateTime.Now ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>