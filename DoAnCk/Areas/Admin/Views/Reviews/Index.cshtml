@model IEnumerable<DoAnCk.Models.Entities.Review>

<div class="container-fluid p-4">
    <h2 class="fw-bold text-primary mb-4"><i class="bi bi-chat-left-dots"></i> Kiểm duyệt bình luận</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h6 class="fw-bold text-primary">@item.User?.FullName</h6>
                            <div class="text-warning">
                                @for (int i = 0; i < item.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </div>
                        </div>
                        <p class="small text-muted mb-2">Đánh giá phòng: <strong>@item.Room?.Title</strong></p>
                        <p class="card-text text-dark">"@item.Comment"</p>
                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-2">
                            <small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa bình luận vi phạm này?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                    <i class="bi bi-trash"></i> Xóa vi phạm
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>