@model IEnumerable<DoAnCk.Models.Entities.Room>

@{
    ViewData["Title"] = "Phê duyệt tin đăng";

    // THAY THẾ CHO @helper: Định nghĩa hàm cục bộ ngay tại đây
    async Task RenderRoomTable(IEnumerable<DoAnCk.Models.Entities.Room> roomList)
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">Thông tin phòng</th>
                            <th>Giá & Diện tích</th>
                            <th>Chủ trọ</th>
                            <th>Ngày đăng</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in roomList)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (item.RoomImages != null && item.RoomImages.Any())
                                        {
                                            <img src="@item.RoomImages.First().ImageUrl" class="rounded me-3 shadow-sm" style="width: 70px; height: 50px; object-fit: cover;">
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@item.Title</div>
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @item.Address</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-danger fw-bold">@item.Price.ToString("N0") đ</div>
                                    <small class="text-muted">@item.Area m²</small>
                                </td>
                                <td>
                                    <div class="small fw-bold text-primary">@item.User?.Email?.Split('@')[0]</div>
                                    <div class="text-muted small">@item.User?.Email</div>
                                </td>
                                <td><small>@item.CreatedDate.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-center">
                                    <div class="btn-group gap-2">
                                        @if (!item.IsApproved)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Duyệt</button>
                                            </form>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-circle"><i class="bi bi-eye"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<div class="container-fluid p-4">
    <h2 class="text-primary fw-bold mb-4">Hệ thống duyệt tin</h2>

    <ul class="nav nav-pills mb-4 p-2 bg-white rounded-pill shadow-sm" id="pills-tab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill" data-bs-toggle="pill" data-bs-target="#waiting">
                Chờ duyệt (@Model.Count(r => !r.IsApproved))
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#approved">
                Đã duyệt (@Model.Count(r => r.IsApproved))
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="waiting">
            @{
                await RenderRoomTable(Model.Where(r => !r.IsApproved));
            }
        </div>
        <div class="tab-pane fade" id="approved">
            @{
                await RenderRoomTable(Model.Where(r => r.IsApproved));
            }
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .nav-pills .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }
    </style>
}