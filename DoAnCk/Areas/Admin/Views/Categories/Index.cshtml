@model IEnumerable<DoAnCk.Models.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold"><i class="bi bi-tags"></i> Quản lý danh mục</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 10%">ID</th>
                        <th>Tên danh mục</th>
                        <th class="text-center" style="width: 20%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                            <td>
                                <span class="fw-bold text-dark">@item.Name</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa danh mục này sẽ ảnh hưởng đến các phòng trọ liên quan. Tiếp tục?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>