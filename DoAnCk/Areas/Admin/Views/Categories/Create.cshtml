@model DoAnCk.Models.Entities.Category

@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container p-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Thêm danh mục mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Tên danh mục</label>
                            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Phòng trọ, Chung cư mini..." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 border-top pt-3">
                            <button type="submit" class="btn btn-primary px-4 rounded-pill">Lưu lại</button>
                            <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>