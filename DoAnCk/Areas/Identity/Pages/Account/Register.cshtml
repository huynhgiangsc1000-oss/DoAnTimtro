@page
@model RegisterModel
@{
    ViewData["Title"] = "Tham gia cùng DoAnCk";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-5 d-none d-md-flex align-items-center justify-content-center p-5 text-white text-center"
                         style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                        <div>
                            <i class="bi bi-house-check display-1 mb-4"></i>
                            <h2 class="fw-bold">Xin chào!</h2>
                            <p class="lead">Hệ thống kết nối chủ trọ và người thuê nhanh chóng, uy tín.</p>
                        </div>
                    </div>

                    <div class="col-md-7 bg-white p-4 p-sm-5">
                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="text-center mb-4">
                                <h3 class="fw-bold text-primary">Đăng ký tài khoản</h3>
                                <p class="text-muted small">Vui lòng điền thông tin để bắt đầu</p>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                            <label class="form-label fw-bold mb-2">Bạn là ai?</label>
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Input.Role" value="Member" id="roleMember" checked>
                                    <label class="btn btn-outline-primary w-100 py-3 rounded-3 d-flex flex-column align-items-center" for="roleMember">
                                        <i class="bi bi-person-bounding-box fs-3"></i>
                                        <span class="mt-1 fw-bold">Người thuê</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Input.Role" value="Host" id="roleHost">
                                    <label class="btn btn-outline-primary w-100 py-3 rounded-3 d-flex flex-column align-items-center" for="roleHost">
                                        <i class="bi bi-person-workspace fs-3"></i>
                                        <span class="mt-1 fw-bold">Chủ trọ</span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.FullName" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="Họ và Tên" />
                                <label class="px-0" asp-for="Input.FullName">Họ và Tên</label>
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="name@example.com" />
                                <label class="px-0" asp-for="Input.Email">Địa chỉ Email</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.Password" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="Mật khẩu" />
                                        <label class="px-0" asp-for="Input.Password">Mật khẩu</label>
                                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.ConfirmPassword" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="Xác nhận" />
                                        <label class="px-0" asp-for="Input.ConfirmPassword">Xác nhận</label>
                                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3 transition-btn">
                                ĐĂNG KÝ <i class="bi bi-arrow-right ms-2"></i>
                            </button>

                            <div class="text-center mt-4">
                                <span class="text-muted small">Đã có tài khoản?</span>
                                <a asp-page="./Login" class="text-primary text-decoration-none fw-bold small">Đăng nhập ngay</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        transition: transform 0.3s;
    }

    .form-control {
        background-color: transparent !important;
    }

        .form-control:focus {
            border-color: #1e3c72 !important;
            color: #1e3c72;
        }

    /* Hiệu ứng cho nút chọn vai trò */
    .btn-check:checked + .btn-outline-primary {
        background-color: #e7f1ff;
        color: #0d6efd;
        border-width: 2px;
        transform: scale(1.05);
    }

    .btn-outline-primary {
        border: 2px solid #dee2e6;
        color: #6c757d;
        transition: all 0.2s ease-in-out;
    }

        .btn-outline-primary:hover {
            border-color: #0d6efd;
            background: transparent;
            color: #0d6efd;
        }

    .transition-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3) !important;
    }
</style>