@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Tắt layout mặc định nếu bạn muốn trang login độc lập hoàn toàn
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f7fe;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
        }

        .login-info-side {
            background: linear-gradient(135deg, #0d6efd 0%, #003d99 100%);
            color: white;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-form-side {
            background: white;
            padding: 3rem;
        }

        .form-control {
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            border: 1px solid #e0e0e0;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.25 margin rgba(13, 110, 253, 0.1);
                border-color: #0d6efd;
            }

        .btn-login {
            border-radius: 0.75rem;
            padding: 0.75rem;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row login-card mx-auto">
            <div class="col-lg-5 login-info-side d-none d-lg-flex">
                <h2 class="fw-bold mb-3">Chào mừng trở lại!</h2>
                <p class="opacity-75">Tìm kiếm và quản lý phòng trọ chưa bao giờ dễ dàng đến thế cùng với EasyRent.</p>
                <div class="mt-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <span>Hàng ngàn tin đăng xác thực</span>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <span>Kết nối chủ trọ nhanh chóng</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 login-form-side">
                <div class="text-center mb-4 d-lg-none">
                    <h2 class="fw-bold text-primary">EasyRent</h2>
                </div>

                <h3 class="fw-bold mb-2">Đăng nhập</h3>
                <p class="text-muted mb-4">Vui lòng nhập thông tin tài khoản của bạn</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label small fw-semibold">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label small fw-semibold">Mật khẩu</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label small text-muted" asp-for="Input.RememberMe">Ghi nhớ tôi</label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-login mb-3">Đăng nhập</button>

                    <div class="text-center">
                        <p class="small text-muted">Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold">Đăng ký ngay</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>