@model DoAnCk.Models.Entities.Review

@{
    ViewData["Title"] = "Viết đánh giá";
}

<div class="review-form-page">
    <div class="review-form-card">
        <div class="review-form-header">
            <h1>Viết đánh giá</h1>
            <p>@ViewBag.RoomTitle</p>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="RoomId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="rating-section">
                <label class="form-label">Chấm điểm phòng</label>
                <div class="star-rating">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star-@i" name="Rating" value="@i" @(Model.Rating == i ? "checked" : "") />
                        <label for="star-@i" title="@i sao">★</label>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comment" class="form-label">Cảm nhận của bạn</label>
                <textarea asp-for="Comment" class="form-control review-textarea" rows="6"
                          placeholder="Hãy chia sẻ trải nghiệm thực tế của bạn về phòng, vị trí, chủ trọ, tiện nghi..."></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="action-group">
                <button type="submit" class="btn-submit-review">Gửi đánh giá</button>
                <a asp-area="Customer"
                   asp-controller="RoomRequests"
                   asp-action="Index"
                   class="btn-cancel-review">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>