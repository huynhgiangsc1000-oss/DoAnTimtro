@model IEnumerable<DoAnCk.Models.Entities.Review>

@{
    ViewData["Title"] = "Đánh giá của tôi";
}

<div class="review-page">
    <div class="review-header">
        <div>
            <h1>Đánh giá của tôi</h1>
            <p>Quản lý các đánh giá bạn đã gửi.</p>
        </div>

        <a asp-area="Customer"
           asp-controller="Reviews"
           asp-action="Create"
           class="btn-create-review">
            Viết đánh giá mới
        </a>
    </div>

    @if (TempData["ReviewError"] != null)
    {
        <div class="alert alert-danger">@TempData["ReviewError"]</div>
    }

    @if (TempData["ReviewSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["ReviewSuccess"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-review">
            <div class="empty-icon">⭐</div>
            <h3>Bạn chưa có đánh giá nào</h3>
            <p>Hãy chia sẻ trải nghiệm thực tế của bạn về phòng trọ.</p>

            <a asp-area="Customer"
               asp-controller="Reviews"
               asp-action="Create"
               class="btn-create-review mt-3">
                Viết đánh giá mới
            </a>
        </div>
    }
    else
    {
        <div class="review-grid">
            @foreach (var item in Model)
            {
                <div class="review-card">
                    <div class="review-card-top">
                        <h3>@item.Room?.Title</h3>
                        <div class="rating-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="@(i <= item.Rating ? "star-filled" : "star-empty")">★</span>
                            }
                        </div>
                    </div>

                    <div class="review-date">
                        @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <div class="review-comment">
                        @item.Comment
                    </div>

                    <div class="review-actions">
                        <a asp-area="Customer"
                           asp-controller="Reviews"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn-soft">
                            Chi tiết
                        </a>

                        <a asp-area="Customer"
                           asp-controller="Reviews"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn-edit">
                            Sửa
                        </a>

                        <a asp-area="Customer"
                           asp-controller="Reviews"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn-delete">
                            Xóa
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .review-page {
        max-width: 1100px;
        margin: 30px auto;
        padding: 0 16px 40px;
    }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

        .review-header h1 {
            font-size: 32px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 6px;
        }

        .review-header p {
            margin: 0;
            color: #6b7280;
        }

    .btn-create-review {
        text-decoration: none;
        background: #2563eb;
        color: #fff;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 700;
    }

    .review-grid {
        display: grid;
        gap: 18px;
    }

    .review-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #eef2f7;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        padding: 20px;
    }

    .review-card-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

        .review-card-top h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 800;
            color: #111827;
        }

    .rating-stars {
        font-size: 18px;
    }

    .star-filled {
        color: #f59e0b;
    }

    .star-empty {
        color: #d1d5db;
    }

    .review-date {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .review-comment {
        color: #374151;
        line-height: 1.7;
        margin-bottom: 16px;
        white-space: pre-line;
    }

    .review-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-soft, .btn-edit, .btn-delete {
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 14px;
    }

    .btn-soft {
        background: #eef2ff;
        color: #4338ca;
    }

    .btn-edit {
        background: #fff7ed;
        color: #ea580c;
    }

    .btn-delete {
        background: #fff1f2;
        color: #e11d48;
    }

    .empty-review {
        text-align: center;
        padding: 60px 20px;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #eef2f7;
    }

    .empty-icon {
        font-size: 52px;
        margin-bottom: 10px;
    }
</style>