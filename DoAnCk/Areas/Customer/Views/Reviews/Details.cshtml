@model DoAnCk.Models.Entities.Review

@{
    ViewData["Title"] = "Chi tiết đánh giá";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="mb-3">Chi tiết đánh giá</h2>

            <p><strong>Phòng:</strong> @Model.Room?.Title</p>
            <p><strong>Ngày đánh giá:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            <p>
                <strong>Số sao:</strong>
                @for (int i = 1; i <= 5; i++)
                {
                    <span style="font-size:20px; color:@(i <= Model.Rating ? "#f59e0b" : "#d1d5db")">★</span>
                }
            </p>
            <p><strong>Nội dung:</strong></p>
            <div class="border rounded p-3 bg-light">
                @Model.Comment
            </div>

            <div class="mt-4 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Xóa</a>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>

<style>
    .review-detail-page {
        max-width: 760px;
        margin: 40px auto;
        padding: 0 16px;
    }

    .review-detail-card {
        background: #fff;
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
        border: 1px solid #eef2f7;
    }

        .review-detail-card h1 {
            font-size: 30px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 22px;
        }

    .detail-block {
        margin-bottom: 18px;
    }

    .detail-label {
        display: block;
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .detail-value, .detail-comment {
        color: #111827;
        font-weight: 600;
        line-height: 1.7;
    }

    .detail-comment {
        white-space: pre-line;
    }

    .rating-stars {
        font-size: 24px;
    }

    .star-filled {
        color: #f59e0b;
    }

    .star-empty {
        color: #d1d5db;
    }

    .detail-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .btn-edit, .btn-delete, .btn-back {
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-edit {
        background: #fff7ed;
        color: #ea580c;
    }

    .btn-delete {
        background: #fff1f2;
        color: #e11d48;
    }

    .btn-back {
        background: #f3f4f6;
        color: #111827;
    }
</style>