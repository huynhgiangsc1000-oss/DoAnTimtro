@model IEnumerable<DoAnCk.Models.Entities.RoomRequest>

@{
    ViewData["Title"] = "Yêu cầu của tôi";
}

<div class="container page-shell">
    <div class="top-action-bar page-header">
        <div>
            <h1 class="page-title">Yêu cầu của tôi</h1>
            <p class="page-subtitle">Quản lý các yêu cầu thuê phòng và ở ghép mà bạn đã gửi.</p>
        </div>

        <a asp-area="Customer"
           asp-controller="RoomRequests"
           asp-action="Create"
           class="btn btn-primary px-4 py-2">
            <i class="fa-solid fa-plus me-2"></i>Gửi yêu cầu mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="modern-card">
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fa-regular fa-folder-open"></i>
                </div>
                <h4>Chưa có yêu cầu nào</h4>
                <p>Bạn chưa gửi yêu cầu thuê phòng nào. Hãy bắt đầu với phòng bạn quan tâm.</p>
                <a asp-area="Customer"
                   asp-controller="RoomRequests"
                   asp-action="Create"
                   class="btn btn-outline-primary px-4 py-2">
                    Tạo yêu cầu đầu tiên
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="modern-card">
            <div class="modern-table-wrap">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Phòng</th>
                            <th>Nội dung</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="room-title">@item.Room?.Title</div>
                                    <div class="meta-text">Mã phòng: @item.RoomId</div>
                                </td>

                                <td style="max-width: 320px;">
                                    @(string.IsNullOrWhiteSpace(item.Message) ? "Không có nội dung." : item.Message)
                                </td>

                                <td>
                                    @item.RequestDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @if (item.Status.ToString() == "Pending")
                                    {
                                        <span class="status-badge status-pending">
                                            <i class="fa-regular fa-clock"></i> Đang chờ
                                        </span>
                                    }
                                    else if (item.Status.ToString() == "Accepted")
                                    {
                                        <span class="status-badge status-accepted">
                                            <i class="fa-solid fa-check"></i> Đã chấp nhận
                                        </span>
                                    }
                                    else if (item.Status.ToString() == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">
                                            <i class="fa-solid fa-xmark"></i> Đã từ chối
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-other">@item.Status</span>
                                    }
                                </td>

                                <td>
                                    <div class="action-group">
                                        <a asp-area="Customer"
                                           asp-controller="RoomRequests"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Chi tiết
                                        </a>

                                        @if (item.Status.ToString() == "Pending")
                                        {
                                            <a asp-area="Customer"
                                               asp-controller="RoomRequests"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Sửa
                                            </a>

                                            <a asp-area="Customer"
                                               asp-controller="RoomRequests"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Xóa
                                            </a>
                                        }

                                        @if (item.Status.ToString() == "Accepted")
                                        {
                                            <a asp-area="Customer"
                                               asp-controller="Reviews"
                                               asp-action="Create"
                                               asp-route-roomId="@item.RoomId"
                                               class="btn btn-sm btn-warning">
                                                Đánh giá
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .page-shell {
        padding-top: 24px;
        padding-bottom: 24px;
    }

    .page-title {
        font-size: 30px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 0;
    }

    .modern-card {
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .modern-card-body {
        padding: 24px;
    }

    .top-action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .modern-table-wrap {
        overflow-x: auto;
    }

    .modern-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .modern-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 14px;
            font-weight: 700;
            padding: 16px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .modern-table tbody td {
            padding: 18px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .modern-table tbody tr:hover {
            background: #fafcff;
        }

    .room-title {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 3px;
    }

    .meta-text {
        font-size: 13px;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-accepted {
        background: #dcfce7;
        color: #166534;
    }

    .status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-other {
        background: #e5e7eb;
        color: #374151;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
    }

    .empty-state {
        text-align: center;
        padding: 56px 20px;
    }

        .empty-state .empty-icon {
            width: 84px;
            height: 84px;
            margin: 0 auto 16px;
            border-radius: 50%;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .empty-state h4 {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #6b7280;
            margin-bottom: 18px;
        }
</style>