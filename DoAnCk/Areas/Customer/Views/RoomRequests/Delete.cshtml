@model DoAnCk.Models.Entities.RoomRequest

@{
    ViewData["Title"] = "Xóa yêu cầu";
}

<div class="container page-shell">
    <div class="form-shell">
        <div class="page-header">
            <h1 class="page-title text-danger">Xóa yêu cầu</h1>
            <p class="page-subtitle">Hãy xác nhận lại thông tin trước khi xóa yêu cầu này.</p>
        </div>

        <div class="modern-card">
            <div class="modern-card-body">
                <dl class="row detail-grid mb-4">
                    <dt class="col-sm-4">Phòng</dt>
                    <dd class="col-sm-8">@Model.Room?.Title</dd>

                    <dt class="col-sm-4">Nội dung</dt>
                    <dd class="col-sm-8">@Model.Message</dd>

                    <dt class="col-sm-4">Ngày gửi</dt>
                    <dd class="col-sm-8">@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="action-group" style="justify-content:flex-start;">
                        <button type="submit" class="btn btn-danger px-4 py-2">
                            <i class="fa-solid fa-trash me-2"></i>Xác nhận xóa
                        </button>

                        <a asp-area="Customer"
                           asp-controller="RoomRequests"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4 py-2">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>