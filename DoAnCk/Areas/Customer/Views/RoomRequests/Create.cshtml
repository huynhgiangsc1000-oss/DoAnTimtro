@model DoAnCk.Models.Entities.RoomRequest

@{
    ViewData["Title"] = "Gửi yêu cầu thuê / ở ghép";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Gửi yêu cầu thuê / ở ghép</h1>
        <p class="text-muted mb-0">
            Điền thông tin rõ ràng để chủ trọ dễ xem xét và phản hồi hơn.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RoomId" class="form-label">Chọn phòng</label>

                    @if (ViewBag.RoomIdLocked != null && (bool)ViewBag.RoomIdLocked)
                    {
                        <input type="hidden" asp-for="RoomId" />
                        <input type="text" class="form-control" value="@ViewBag.RoomTitle" readonly />
                    }
                    else
                    {
                        <select asp-for="RoomId" asp-items="ViewBag.RoomId" class="form-select">
                            <option value="">-- Chọn phòng --</option>
                        </select>
                    }

                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label">Nội dung yêu cầu</label>
                    <textarea asp-for="Message"
                              class="form-control"
                              rows="6"
                              placeholder="Ví dụ: Em muốn thuê phòng từ đầu tháng tới, mong được hỗ trợ thêm thông tin về giá thuê, tiền cọc và nội quy."></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Gửi yêu cầu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}