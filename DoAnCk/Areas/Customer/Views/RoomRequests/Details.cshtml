@using DoAnCk.Models.Entities
@model DoAnCk.Models.Entities.RoomRequest

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h3 class="mb-0 text-primary">
                <i class="fas fa-paper-plane me-2"></i>Chi tiết yêu cầu thuê phòng
            </h3>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Phòng trọ</label>
                <div>
                    <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId" class="text-decoration-none">
                        @Model.Room?.Title
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Ngày gửi</label>
                <div>@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Lời nhắn của bạn</label>
                <div class="border rounded p-3 bg-light">@Model.Message</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Trạng thái</label>
                <div>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Đang chờ</span>
                    }
                    else if (Model.Status == RequestStatus.Accepted)
                    {
                        <span class="badge bg-success">Đã chấp nhận</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đã từ chối</span>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Phản hồi từ chủ trọ</label>
                <div class="border rounded p-3 bg-light">
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        @Model.Note
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Chưa có phản hồi từ chủ trọ.</span>
                    }
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</div>