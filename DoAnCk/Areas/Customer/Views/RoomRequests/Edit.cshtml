@model DoAnCk.Models.Entities.RoomRequest

@{
    ViewData["Title"] = "Chỉnh sửa yêu cầu";
    string roomTitle = ViewBag.RoomTitle as string ?? "";
}

<div class="container page-shell">
    <div class="form-shell">
        <div class="page-header">
            <h1 class="page-title">Chỉnh sửa yêu cầu</h1>
            <p class="page-subtitle">Bạn chỉ nên cập nhật nội dung khi yêu cầu vẫn đang ở trạng thái chờ xử lý.</p>
        </div>

        <div class="modern-card">
            <div class="modern-card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="RoomId" type="hidden" />

                    <div class="mb-3">
                        <label class="form-label">Phòng</label>
                        <input type="text" class="form-control" value="@roomTitle" readonly />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label">Nội dung yêu cầu</label>
                        <textarea asp-for="Message" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <div class="action-group" style="justify-content:flex-start;">
                        <button type="submit" class="btn btn-warning px-4 py-2">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Cập nhật
                        </button>

                        <a asp-area="Customer"
                           asp-controller="RoomRequests"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4 py-2">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}