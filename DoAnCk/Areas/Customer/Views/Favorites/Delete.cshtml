@model DoAnCk.Models.Entities.Favorite

@{
    ViewData["Title"] = "Bỏ yêu thích";
    var room = Model.Room;
    var mainImage = room?.RoomImages?.FirstOrDefault(x => x.IsMain)?.ImageUrl
                 ?? room?.RoomImages?.FirstOrDefault()?.ImageUrl
                 ?? "https://via.placeholder.com/800x500?text=No+Image";
}

<div class="delete-favorite-page">
    <div class="delete-card">
        <img src="@mainImage" alt="@room?.Title" class="delete-image" />

        <div class="delete-icon">💔</div>
        <h2>Bỏ phòng khỏi danh sách yêu thích?</h2>
        <p>
            Phòng <strong>@room?.Title</strong> sẽ bị xóa khỏi danh sách đã lưu của bạn.
        </p>

        <form asp-action="Delete" method="post" class="delete-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-delete">Bỏ yêu thích</button>
            <a asp-action="Index" class="btn-cancel">Hủy</a>
        </form>
    </div>
</div>

<style>
    .delete-favorite-page {
        max-width: 720px;
        margin: 60px auto;
        padding: 0 16px;
    }

    .delete-card {
        background: #fff;
        border-radius: 20px;
        padding: 24px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        border: 1px solid #eef2f7;
    }

    .delete-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
        border-radius: 16px;
        margin-bottom: 18px;
    }

    .delete-icon {
        font-size: 52px;
        margin-bottom: 12px;
    }

    .delete-card h2 {
        margin-bottom: 10px;
        color: #111827;
        font-weight: 700;
    }

    .delete-card p {
        color: #6b7280;
        line-height: 1.6;
        margin-bottom: 22px;
    }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-delete,
    .btn-cancel {
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
    }

    .btn-delete {
        background: #e11d48;
        color: #fff;
    }

    .btn-cancel {
        background: #f3f4f6;
        color: #111827;
    }
</style>