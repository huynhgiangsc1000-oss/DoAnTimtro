@model IEnumerable<DoAnCk.Models.Entities.Favorite>

<div class="container mt-4">
    <h3 class="fw-bold mb-4"><i class="fas fa-heart text-danger me-2"></i>Phòng trọ đã lưu</h3>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <img src="/images/empty-favorite.png" style="width: 200px; opacity: 0.5" />
            <p class="text-muted mt-3">Bạn chưa lưu phòng trọ nào.</p>
            <a href="/" class="btn btn-primary">Khám phá ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4" id="fav-card-@item.Id">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <button onclick="toggleFavorite(@item.RoomId, @item.Id)"
                                class="btn btn-light position-absolute top-0 end-0 m-2 shadow-sm rounded-circle">
                            <i class="fas fa-trash text-danger"></i>
                        </button>

                        <img src="@item.Room.RoomImages.FirstOrDefault(i => i.IsMain)?.ImageUrl"
                             class="card-img-top" style="height: 200px; object-fit: cover;">

                        <div class="card-body">
                            <h5 class="card-title text-truncate">@item.Room.Title</h5>
                            <p class="text-danger fw-bold mb-1">@item.Room.Price.ToString("N0") đ/tháng</p>
                            <p class="small text-muted"><i class="fas fa-map-marker-alt me-1"></i>@item.Room.Address</p>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.RoomId"
                               class="btn btn-outline-primary w-100">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function toggleFavorite(roomId, favId) {
        if(confirm("Bạn muốn bỏ lưu phòng này?")) {
            // Gọi đến Action Toggle trong FavoritesController
            $.post('/Customer/Favorites/Toggle', { roomId: roomId }, function(res) {
                if(res.success) {
                    $('#fav-card-' + favId).fadeOut();
                }
            });
        }
    }
</script>