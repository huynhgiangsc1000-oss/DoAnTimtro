@model DoAnCk.Models.Entities.Favorite

@{
    ViewData["Title"] = "Chi tiết yêu thích";
    var room = Model.Room;
    var mainImage = room?.Images?.FirstOrDefault(x => x.IsMain)?.ImageUrl
                 ?? room?.Images?.FirstOrDefault()?.ImageUrl
                 ?? "https://via.placeholder.com/800x500?text=No+Image";
}

<div class="favorite-detail-page">
    <div class="favorite-detail-card">
        <div class="favorite-detail-image">
            <img src="@mainImage" alt="@room?.Title" />
        </div>

        <div class="favorite-detail-content">
            <div class="saved-tag">Đã lưu vào yêu thích</div>

            <h1>@room?.Title</h1>

            <div class="price">@String.Format("{0:N0}", room?.Price) đ/tháng</div>

            <div class="detail-list">
                <p><strong>Diện tích:</strong> @room?.Area m²</p>
                <p><strong>Địa chỉ:</strong> @room?.Address</p>
                <p><strong>Người lưu:</strong> @Model.User?.FullName</p>
            </div>

            <div class="action-group">
                <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@room?.Id" class="btn-main">
                    Xem phòng
                </a>
                <a asp-action="Index" class="btn-sub">Quay lại</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-danger-soft">Bỏ yêu thích</a>
            </div>
        </div>
    </div>
</div>

<style>
    .favorite-detail-page {
        max-width: 1100px;
        margin: 32px auto;
        padding: 0 16px 40px;
    }

    .favorite-detail-card {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
        border: 1px solid #eef2f7;
    }

    .favorite-detail-image img {
        width: 100%;
        height: 100%;
        min-height: 460px;
        object-fit: cover;
        display: block;
    }

    .favorite-detail-content {
        padding: 28px;
    }

    .saved-tag {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        background: #fff1f2;
        color: #e11d48;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .favorite-detail-content h1 {
        font-size: 30px;
        color: #111827;
        margin-bottom: 14px;
    }

    .price {
        font-size: 28px;
        font-weight: 800;
        color: #dc2626;
        margin-bottom: 20px;
    }

    .detail-list p {
        font-size: 15px;
        color: #374151;
        margin-bottom: 12px;
        line-height: 1.6;
    }

    .action-group {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn-main,
    .btn-sub,
    .btn-danger-soft {
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 600;
    }

    .btn-main {
        background: #2563eb;
        color: #fff;
    }

        .btn-main:hover {
            color: #fff;
            background: #1d4ed8;
        }

    .btn-sub {
        background: #f3f4f6;
        color: #111827;
    }

    .btn-danger-soft {
        background: #fff1f2;
        color: #e11d48;
    }

    @@media (max-width: 900px) {
        .favorite-detail-card {
            grid-template-columns: 1fr;
        }

        .favorite-detail-image img {
            min-height: 260px;
        }
    }
</style>