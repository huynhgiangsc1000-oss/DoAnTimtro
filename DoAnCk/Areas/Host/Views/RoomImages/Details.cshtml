@model DoAnCk.Models.Entities.RoomImage

@{
    ViewData["Title"] = "Chi tiết hình ảnh";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Chi tiết hình ảnh</h5>
                    <span class="badge bg-light text-dark">ID: #@Model.Id</span>
                </div>
                <div class="card-body p-0 text-center bg-light">
                    <div class="p-4">
                        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm border"
                             style="max-height: 500px; width: auto;" alt="Room Image" />
                    </div>

                    <div class="p-4 border-top bg-white">
                        <div class="row text-start">
                            <div class="col-sm-4 fw-bold text-muted">Thuộc phòng:</div>
                            <div class="col-sm-8 text-primary fw-bold">@Model.Room?.Title</div>
                        </div>
                        <hr />
                        <div class="row text-start">
                            <div class="col-sm-4 fw-bold text-muted">Đường dẫn tệp:</div>
                            <div class="col-sm-8"><code class="text-break">@Model.ImageUrl</code></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white py-3">
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" asp-route-roomId="@Model.RoomId" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left"></i> Quay lại danh sách
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn có chắc muốn xóa ảnh này?')">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash"></i> Xóa ảnh
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>