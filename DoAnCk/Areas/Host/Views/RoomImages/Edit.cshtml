@model DoAnCk.Models.Entities.RoomImage

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0"><i class="fas fa-edit"></i> Thay đổi hình ảnh</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <label class="form-label d-block text-muted">Ảnh hiện tại:</label>
                        <img src="@Model.ImageUrl" class="img-thumbnail" style="max-height: 200px;" />
                    </div>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="RoomId" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="mb-4 text-start">
                            <label class="form-label fw-bold">Chọn ảnh mới thay thế:</label>
                            <input type="file" name="newImageFile" class="form-control" accept="image/*" required />
                            <small class="text-danger">* Lưu ý: Ảnh cũ sẽ bị xóa vĩnh viễn.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning">Cập nhật ảnh</button>
                            <a asp-action="Index" asp-route-roomId="@Model.RoomId" class="btn btn-light">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>