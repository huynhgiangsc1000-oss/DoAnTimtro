@model DoAnCk.Models.Entities.RoomImage

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Tải ảnh lên cho phòng</h5>
                </div>
                <div class="card-body p-4 text-center">
                    @* QUAN TRỌNG: Phải có enctype="multipart/form-data" *@
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="RoomId" />

                        <div class="mb-4">
                            <label class="form-label d-block text-muted mb-3">Chọn file ảnh từ máy tính (JPG, PNG...)</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Bắt đầu tải lên</button>
                            <a asp-action="Index" asp-route-roomId="@Model.RoomId" class="btn btn-light">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>