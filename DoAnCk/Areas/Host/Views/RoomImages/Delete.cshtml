@model DoAnCk.Models.Entities.RoomImage

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h5 class="mb-0">Xác nhận xóa ảnh</h5>
                </div>
                <div class="card-body text-center p-4">
                    <p class="text-muted">Bạn có chắc chắn muốn xóa tấm ảnh này không?</p>
                    <div class="mb-4">
                        <img src="@Model.ImageUrl" class="img-fluid rounded border" style="max-height: 250px;" />
                    </div>

                    <form asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-around">
                            <a asp-action="Index" asp-route-roomId="@Model.RoomId" class="btn btn-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-danger px-4">Xác nhận xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>