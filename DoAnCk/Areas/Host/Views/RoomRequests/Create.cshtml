@model DoAnCk.Models.Entities.RoomRequest

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">Gửi yêu cầu thuê phòng</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        @* Hidden field để biết khách đang gửi cho phòng nào *@
                        <input type="hidden" asp-for="RoomId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên phòng:</label>
                            <input class="form-control bg-light" value="@ViewBag.RoomTitle" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Message" class="form-label fw-bold">Lời nhắn cho chủ trọ</label>
                            <textarea asp-for="Message" class="form-control" rows="4" placeholder="Ví dụ: Mình muốn xem phòng vào chiều mai..."></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Gửi yêu cầu ngay</button>
                            <a href="javascript:history.back()" class="btn btn-link text-secondary">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>