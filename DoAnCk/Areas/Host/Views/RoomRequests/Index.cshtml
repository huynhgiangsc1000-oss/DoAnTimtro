@using DoAnCk.Models.Entities
@model IEnumerable<DoAnCk.Models.Entities.RoomRequest>

@{
    var total = Model?.Count() ?? 0;
    var pending = Model?.Count(x => x.Status == RequestStatus.Pending) ?? 0;
    var accepted = Model?.Count(x => x.Status == RequestStatus.Accepted) ?? 0;
    var rejected = Model?.Count(x => x.Status == RequestStatus.Rejected) ?? 0;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Yêu cầu từ khách thuê</h2>
            <p class="text-muted mb-0">Quản lý các yêu cầu khách gửi đến những phòng của bạn.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Tổng yêu cầu</div>
                    <div class="fs-4 fw-bold">@total</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Chờ duyệt</div>
                    <div class="fs-4 fw-bold text-warning">@pending</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Đã chấp nhận</div>
                    <div class="fs-4 fw-bold text-success">@accepted</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Đã từ chối</div>
                    <div class="fs-4 fw-bold text-danger">@rejected</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Khách hàng</th>
                            <th>Phòng quan tâm</th>
                            <th>Ngày gửi</th>
                            <th>Lời nhắn</th>
                            <th>Phản hồi của bạn</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.Sender?.FullName</div>
                                        <small class="text-muted">@item.Sender?.PhoneNumber</small>
                                    </td>
                                    <td>
                                        <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.RoomId" class="text-decoration-none">
                                            @item.Room?.Title
                                        </a>
                                    </td>
                                    <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="max-width: 220px;">
                                        <small>@item.Message</small>
                                    </td>
                                    <td style="max-width: 220px;">
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <small>@item.Note</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted fst-italic">Chưa phản hồi</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == RequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                        }
                                        else if (item.Status == RequestStatus.Accepted)
                                        {
                                            <span class="badge bg-success">Đã chấp nhận</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Đã từ chối</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Hiện chưa có yêu cầu nào từ khách thuê.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>s