@using DoAnCk.Models.Entities
@model DoAnCk.Models.Entities.RoomRequest

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa</h4>
                </div>
                <div class="card-body text-center">
                    <p class="fs-5">Bạn có chắc chắn muốn xóa yêu cầu thuê phòng của:</p>
                    <h3 class="text-danger">@Model.Sender?.FullName</h3>
                    <p class="text-muted">Hành động này không thể hoàn tác.</p>

                    <div class="alert alert-light border">
                        <strong>Phòng:</strong> @Model.Room?.Title <br />
                        <strong>Ngày gửi:</strong> @Model.RequestDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="card-footer bg-white d-flex justify-content-around py-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger px-4">Xác nhận xóa</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>