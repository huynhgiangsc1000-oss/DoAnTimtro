@using DoAnCk.Models.Entities
@model DoAnCk.Models.Entities.RoomRequest

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h3 class="mb-0 text-primary">
                <i class="fas fa-envelope-open-text me-2"></i>Chi tiết yêu cầu thuê phòng
            </h3>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Khách gửi</label>
                <div>@Model.Sender?.FullName</div>
                <small class="text-muted">@Model.Sender?.PhoneNumber</small>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Phòng quan tâm</label>
                <div>
                    <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId" class="text-decoration-none">
                        @Model.Room?.Title
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Ngày gửi</label>
                <div>@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Lời nhắn từ khách</label>
                <div class="border rounded p-3 bg-light">@Model.Message</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Trạng thái hiện tại</label>
                <div>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                    }
                    else if (Model.Status == RequestStatus.Accepted)
                    {
                        <span class="badge bg-success">Đã chấp nhận</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đã từ chối</span>
                    }
                </div>
            </div>

            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="fw-bold">Phản hồi cho khách thuê</label>
                    <textarea name="note" class="form-control" rows="4" placeholder="Ví dụ: Bạn có thể qua xem phòng lúc 18h, vui lòng liên hệ trước...">@Model.Note</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" name="status" value="@RequestStatus.Accepted" class="btn btn-success">
                        <i class="fas fa-check me-1"></i> Chấp nhận
                    </button>

                    <button type="submit" name="status" value="@RequestStatus.Rejected" class="btn btn-danger">
                        <i class="fas fa-times me-1"></i> Từ chối
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>