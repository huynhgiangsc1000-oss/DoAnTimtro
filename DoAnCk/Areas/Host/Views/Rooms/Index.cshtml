@model IEnumerable<DoAnCk.Models.Entities.Room>
@{
    ViewData["Title"] = "Quản lý tin đăng";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">Danh sách tin đăng</h5>
                <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                    <i class="fas fa-plus me-1"></i> Đăng tin mới
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Ảnh</th>
                            <th>Tiêu đề bài đăng</th>
                            <th>Loại phòng</th>
                            <th>Giá thuê</th>
                            <th>Diện tích</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="room-row-@item.Id">
                                <td class="ps-4">
                                    <img src="@(item.RoomImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png")"
                                         class="img-thumbnail-custom shadow-sm" alt="Room Image"
                                         style="width: 80px; height: 60px; object-fit: cover; border-radius: 8px;">
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="title-link fw-bold text-decoration-none">@item.Title</a>
                                    <div class="text-muted small mt-1">
                                        <i class="fas fa-map-marker-alt me-1 text-danger"></i> @item.Address
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-normal">
                                        @item.Category?.Name
                                    </span>
                                </td>
                                <td>
                                    <span class="text-danger fw-bold">@item.Price.ToString("N0") đ</span>
                                    <small class="text-muted">/tháng</small>
                                </td>
                                <td>
                                    <span class="fw-bold">25 m²</span>
                                </td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                                            <i class="fas fa-check-circle me-1"></i> Đã duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3">
                                            <i class="fas fa-pause-circle me-1"></i> Chờ duyệt
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm rounded-3 overflow-hidden">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm border-end" title="Xem chi tiết">
                                            <i class="fas fa-eye text-primary"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm border-end" title="Sửa tin">
                                            <i class="fas fa-pen text-warning"></i>
                                        </a>
                                        <a asp-controller="RoomImages" asp-action="Index" asp-route-roomId="@item.Id" class="btn btn-white btn-sm border-end" title="Quản lý ảnh">
                                            <i class="fas fa-camera text-info"></i>
                                        </a>
                                        <button type="button" class="btn btn-white btn-sm" onclick="confirmDelete(@item.Id)" title="Xóa">
                                            <i class="fas fa-trash-alt text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Bạn sẽ không thể khôi phục lại tin đăng này!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gọi Ajax lên server để xóa
                    $.ajax({
                        url: '@Url.Action("Delete", "Rooms")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Đã xóa!',
                                    response.message,
                                    'success'
                                );
                                // Xóa dòng trên table mà không cần load lại trang
                                $("#room-row-" + id).fadeOut(500, function() {
                                    $(this).remove();
                                });
                            } else {
                                Swal.fire(
                                    'Lỗi!',
                                    response.message,
                                    'error'
                                );
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi!', 'Không thể thực hiện yêu cầu.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}

<style>
    /* CSS bổ sung để giao diện chuyên nghiệp hơn */
    .title-link {
        color: #2c3e50;
        transition: color 0.2s;
    }

        .title-link:hover {
            color: #3498db;
        }

    .btn-white {
        background-color: #fff;
        border: 1px solid #dee2e6;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }
    /* Các màu nền nhẹ cho Badge */
    .bg-success-subtle {
        background-color: #d1e7dd !important;
    }

    .text-success {
        color: #0f5132 !important;
    }

    .bg-warning-subtle {
        background-color: #fff3cd !important;
    }

    .text-warning {
        color: #664d03 !important;
    }
</style>