@model IEnumerable<DoAnCk.Models.Entities.Room>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h2 class="text-uppercase fw-bold text-primary mb-0">Quản lý phòng trọ của tôi</h2>
            <p class="text-muted small">Bạn đang có @Model.Count() bài đăng trên hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm px-4">
            <i class="fas fa-plus me-1"></i> Đăng tin mới
        </a>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Tìm kiếm theo tên hoặc địa chỉ...">
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 100px;">Ảnh</th>
                            <th>Tiêu đề bài đăng</th>
                            <th>Loại phòng</th>
                            <th>Giá thuê</th>
                            <th>Diện tích</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="roomTableBody">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (item.RoomImages != null && item.RoomImages.Any())
                                    {
                                        <img src="@item.RoomImages.First().ImageUrl" class="rounded shadow-sm" style="width: 70px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 70px; height: 50px;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i>@item.Address</small>
                                </td>
                                <td><span class="badge border text-dark fw-normal bg-light">@item.Category?.Name</span></td>
                                <td class="text-danger fw-bold">@item.Price.ToString("N0") <small>VNĐ</small></td>
                                <td>@item.Area m²</td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            <i class="fas fa-check-circle me-1"></i>Đã duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                            <i class="fas fa-clock me-1"></i>Chờ duyệt
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group shadow-sm">
                                        <button type="button" class="btn btn-sm btn-outline-warning favorite-btn"
                                                data-room-id="@item.Id" title="Thêm vào yêu thích">
                                            <i class="far fa-heart"></i>
                                        </button>

                                        <a asp-controller="RoomImages" asp-action="Index" asp-route-roomId="@item.Id"
                                           class="btn btn-sm btn-outline-success" title="Quản lý hình ảnh">
                                            <i class="fas fa-images"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Script tìm kiếm nhanh trên bảng
        document.getElementById('searchInput').addEventListener('keyup', function() {
            var value = this.value.toLowerCase();
            var rows = document.querySelectorAll('#roomTableBody tr');
            rows.forEach(function(row) {
                row.style.display = row.innerText.toLowerCase().indexOf(value) > -1 ? '' : 'none';
            });
        });

        // 2. Script xử lý hiệu ứng nút Yêu thích
        document.querySelectorAll('.favorite-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                if (icon.classList.contains('far')) {
                    // Chuyển thành tim đỏ
                    icon.classList.replace('far', 'fas');
                    this.classList.add('active');
                    icon.style.color = '#dc3545';
                } else {
                    // Chuyển lại thành tim rỗng
                    icon.classList.replace('fas', 'far');
                    this.classList.remove('active');
                    icon.style.color = '';
                }
            });
        });
    </script>

    <style>
        /* Hiệu ứng khi hover vào hàng của bảng */
        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
            transition: 0.3s;
        }
        /* Style cho nút yêu thích */
        .favorite-btn:hover i {
            transform: scale(1.2);
            transition: 0.2s;
        }
    </style>
}