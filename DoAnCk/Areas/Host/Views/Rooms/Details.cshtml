@model DoAnCk.Models.Entities.Room

<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        @* HEADER: Cập nhật Status và ViewCount *@
        <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center border-0">
            <div>
                <h4 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>@Model.Title</h4>
                <small class="opacity-75"><i class="fas fa-eye me-1"></i> Lượt xem: @Model.ViewCount</small>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Status == 1)
                {
                    <span class="badge bg-success shadow-sm px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Đang hiển thị</span>
                }
                else if (Model.Status == 2)
                {
                    <span class="badge bg-danger shadow-sm px-3 py-2 rounded-pill"><i class="fas fa-door-closed me-1"></i> Đã cho thuê</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark shadow-sm px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i> Chờ duyệt</span>
                }
            </div>
        </div>

        <div class="card-body p-4 bg-white">
            <div class="row g-4">
                <div class="col-md-7">
                    @* Thông tin cơ bản *@
                    <div class="p-4 bg-light rounded-4 shadow-sm border-start border-info border-5">
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted"><i class="fas fa-tag me-2"></i>Giá thuê:</div>
                            <div class="col-sm-8 text-danger fw-bold fs-4">@Model.Price.ToString("N0") <small class="fs-6">VNĐ/tháng</small></div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted"><i class="fas fa-expand-arrows-alt me-2"></i>Diện tích:</div>
                            <div class="col-sm-8 fw-bold">@Model.Area m²</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted"><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ:</div>
                            <div class="col-sm-8 text-primary fw-medium">@Model.Address</div>
                        </div>
                    </div>

                    @* TIỆN ÍCH: Lấy Icon động từ Database *@
                    <h5 class="mt-5 mb-3 text-dark fw-bold"><i class="fas fa-concierge-bell me-2 text-info"></i>Tiện ích đi kèm</h5>
                    <div class="row g-3 mb-4">
                        @if (Model.RoomAmenities != null && Model.RoomAmenities.Any())
                        {
                            foreach (var item in Model.RoomAmenities)
                            {
                                <div class="col-6 col-lg-4">
                                    <div class="d-flex align-items-center p-2 border rounded-3 bg-white shadow-xs hover-info transition-all">
                                        <i class="@(string.IsNullOrEmpty(item.Amenity?.IconClass) ? "fas fa-check-circle" : item.Amenity.IconClass) text-success me-2"></i>
                                        <span class="small fw-bold text-secondary">@item.Amenity?.Name</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12"><p class="text-muted small fst-italic">Chưa cập nhật tiện ích.</p></div>
                        }
                    </div>

                    @* Mô tả *@
                    <h5 class="mt-4 mb-3 text-dark fw-bold"><i class="fas fa-align-left me-2 text-info"></i>Mô tả chi tiết</h5>
                    <div class="text-secondary p-3 bg-light rounded-3 border" style="white-space: pre-line; line-height: 1.8;">
                        @Model.Description
                    </div>

                    @* BẢN ĐỒ: Hoàn chỉnh với dữ liệu động *@
                    <h5 class="mt-5 mb-3 text-dark fw-bold"><i class="fas fa-map-marked-alt me-2 text-info"></i>Vị trí thực tế</h5>
                    <div class="shadow rounded-4 overflow-hidden border">
                        @{
                            // Mã hóa địa chỉ để truyền vào URL của Google Maps
                            var encodedLoc = System.Net.WebUtility.UrlEncode(Model.Address);
                            var mapSrc = $"https://maps.google.com/maps?q={encodedLoc}&t=&z=15&ie=UTF8&iwloc=&output=embed";
                        }
                        <div class="ratio ratio-16x9">
                            <iframe src="@mapSrc"
                                    frameborder="0"
                                    style="border:0;"
                                    allowfullscreen
                                    loading="lazy">
                            </iframe>
                        </div>
                        <div class="bg-light p-2 text-center border-top">
                            <a href="https://www.google.com/maps/search/?api=1&query=@encodedLoc" target="_blank" class="btn btn-sm btn-link text-decoration-none fw-bold">
                                <i class="fas fa-external-link-alt me-1"></i> Xem trên Google Maps
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    @* Carousel ảnh *@
                    <h5 class="mb-3 text-dark fw-bold"><i class="fas fa-images me-2 text-info"></i>Hình ảnh thực tế</h5>
                    @if (Model.RoomImages != null && Model.RoomImages.Any())
                    {
                        <div id="roomImagesCarousel" class="carousel slide shadow-sm rounded-4 overflow-hidden border" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (int i = 0; i < Model.RoomImages.Count(); i++)
                                {
                                    var img = Model.RoomImages.ElementAt(i);
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@img.ImageUrl" class="d-block w-100" style="height: 350px; object-fit: cover;" alt="Room Image">
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#roomImagesCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#roomImagesCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
                            </button>
                        </div>
                    }

                    @* Thông tin chủ trọ & Nút hành động nhanh *@
                    <div class="card mt-4 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-4 text-center bg-light">
                            <img src="https://ui-avatars.com/api/?name=@(System.Net.WebUtility.UrlEncode(Model.User?.FullName))&background=0dcaf0&color=fff" class="rounded-circle shadow-sm mb-3" width="70">
                            <h6 class="fw-bold">@Model.User?.FullName</h6>

                            <div class="d-grid gap-2 mt-3">
                                @if (Model.Status == 1)
                                {
                                    <form asp-action="ToggleStatus" method="post">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="2" />
                                        <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold shadow-sm">
                                            <i class="fas fa-door-closed me-2"></i>Đánh dấu Đã cho thuê
                                        </button>
                                    </form>
                                }
                                <a href="tel:@Model.PhoneNumber" class="btn btn-outline-info rounded-pill fw-bold border-2 shadow-sm">
                                    <i class="fas fa-phone-alt me-2"></i>@Model.PhoneNumber
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* FOOTER NÚT ĐIỀU HƯỚNG *@
        <div class="card-footer bg-white py-4 d-flex justify-content-center gap-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-bold">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 py-2 rounded-pill fw-bold shadow-sm">
                <i class="fas fa-edit me-2"></i>Chỉnh sửa
            </a>
        </div>
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .hover-info:hover {
        border-color: #0dcaf0 !important;
        transform: translateY(-2px);
        background-color: #f0faff !important;
    }

    .shadow-xs {
        shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }
</style>