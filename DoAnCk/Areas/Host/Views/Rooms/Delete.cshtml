@model DoAnCk.Models.Entities.Room

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> XÁC NHẬN XÓA BÀI ĐĂNG</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <p class="fs-5">Bạn có chắc chắn muốn xóa bài đăng này không?</p>
                        <h4 class="text-primary fw-bold">@Model.Title</h4>
                        <span class="text-muted small">ID: #@Model.Id | Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="alert alert-warning border-warning">
                        <ul class="mb-0 small">
                            <li>Hành động này <strong>không thể hoàn tác</strong>.</li>
                            <li>Tất cả hình ảnh liên quan sẽ bị gỡ bỏ.</li>
                            <li>Các đánh giá (nếu có) cũng sẽ bị xóa theo.</li>
                        </ul>
                    </div>

                    <div class="bg-light p-3 rounded mb-4">
                        <div class="row">
                            <div class="col-6 text-muted">Giá thuê:</div>
                            <div class="col-6 fw-bold text-danger text-end">@Model.Price.ToString("N0") VNĐ</div>

                            <div class="col-6 text-muted">Diện tích:</div>
                            <div class="col-6 text-end">@Model.Area m²</div>

                            <div class="col-6 text-muted">Địa chỉ:</div>
                            <div class="col-6 text-end small">@Model.Address</div>
                        </div>
                    </div>

                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash-alt"></i> Đồng ý xóa vĩnh viễn
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Quay lại danh sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>