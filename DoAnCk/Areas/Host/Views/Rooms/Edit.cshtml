@model DoAnCk.Models.Entities.Room

<div class="container mt-4">
    <div class="card shadow border-warning">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0"><i class="fas fa-edit"></i> Chỉnh sửa thông tin phòng</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                @* Các trường ẩn để giữ nguyên dữ liệu cũ không đổi *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="IsApproved" />

                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài đăng</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">Địa chỉ chính xác</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Nội dung mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Giá thuê (VNĐ)</label>
                                <input asp-for="Price" class="form-control" />
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="Area" class="form-label fw-bold">Diện tích (m²)</label>
                                <input asp-for="Area" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Loại phòng</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh hiện tại</label>
                            <div class="row g-2 mb-2">
                                @if (Model.RoomImages != null && Model.RoomImages.Any())
                                {
                                    foreach (var img in Model.RoomImages)
                                    {
                                        <div class="col-4 position-relative">
                                            <img src="@img.ImageUrl" class="img-thumbnail w-100" style="height: 80px; object-fit: cover;" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small italic ps-2">Chưa có ảnh nào.</p>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary">Tải lên ảnh mới</label>
                            <input type="file" name="newImages" class="form-control" multiple accept="image/*" />
                            <small class="text-muted">Lưu ý: Ảnh mới sẽ được thêm vào danh sách hiện có.</small>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-success px-5 shadow-sm">
                        <i class="fas fa-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}