@model DoAnCk.Models.Entities.Room

<div class="container mt-4 mb-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i> Đăng tin cho thuê mới</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold text-primary">Tiêu đề</label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Phòng trọ sinh viên gần HUTECH..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold text-primary">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, quận/huyện..." />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold text-primary">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Thông tin về phòng, giờ giấc, tiện ích chung..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary"><i class="fas fa-tags me-2"></i>Tiện ích có sẵn</label>
                            <div class="row g-2 border rounded p-3 bg-light">
                                @if (ViewBag.Amenities != null)
                                {
                                    @foreach (var amenity in (List<DoAnCk.Models.Entities.Amenity>)ViewBag.Amenities)
                                    {
                                        <div class="col-md-4 col-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="selectedAmenities" value="@amenity.Id" id="amenity_@amenity.Id">
                                                <label class="form-check-label" for="amenity_@amenity.Id">
                                                    <i class="@amenity.IconClass text-secondary me-1"></i> @amenity.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-light border-0 p-3 shadow-sm">
                            <div class="mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Giá thuê (VNĐ/tháng)</label>
                                <input asp-for="Price" type="number" class="form-control" placeholder="0" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Area" class="form-label fw-bold">Diện tích (m²)</label>
                                <input asp-for="Area" class="form-control" placeholder="0" />
                                <span asp-validation-for="Area" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="CategoryId" class="form-label fw-bold">Loại hình</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-danger">Hình ảnh (Tối đa 5-10 ảnh)</label>
                                <input type="file" name="images" multiple class="form-control" accept="image/*" id="imageInput" />
                                <small class="text-muted">Ảnh đầu tiên sẽ là ảnh đại diện.</small>
                                <div id="imagePreview" class="row mt-2 g-2"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 me-2">Quay lại</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold">ĐĂNG TIN NGAY</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview ảnh thông minh
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';

            if (this.files.length > 0) {
                Array.from(this.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = f => {
                        const isMainLabel = index === 0 ? '<span class="badge bg-danger position-absolute top-0 start-0 m-1" style="font-size:10px">Ảnh chính</span>' : '';
                        preview.innerHTML += `
                            <div class="col-4 position-relative">
                                ${isMainLabel}
                                <img src="${f.target.result}" class="img-thumbnail" style="height:80px; width:100%; object-fit:cover;">
                            </div>`;
                    };
                    reader.readAsDataURL(file);
                });
            }
        });
    </script>
}